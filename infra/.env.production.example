# ============================================================
# Mini Booking System - Production Environment Variables
# ============================================================
# File này được CD workflow TỰ ĐỘNG generate từ GitHub Secrets + Variables.
# Bạn KHÔNG CẦN tạo thủ công trừ khi debug trước lần deploy đầu.
# NEVER commit .env.production to git
# ============================================================

# ─── Domain & URLs (GitHub Secrets) ───────────────────────
FRONTEND_DOMAIN=trannam.xyz
API_DOMAIN=api.trannam.xyz
SSL_EMAIL=admin@trannam.xyz
API_BASE_URL=https://api.trannam.xyz
FRONTEND_URL=https://trannam.xyz
VITE_API_URL=https://api.trannam.xyz

# ─── PostgreSQL (GitHub Secrets) ──────────────────────────
POSTGRES_USER=booking_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=mini_booking_system

# ─── Redis (GitHub Secrets + Variables) ───────────────────
REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_MAXMEMORY=400mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# ─── JWT (GitHub Secrets) ─────────────────────────────────
JWT_SECRET=CHANGE_ME_minimum_32_characters_random_string
JWT_ISSUER=MiniBookingSystem
JWT_AUDIENCE=MiniBookingSystemUsers

# ─── Google OAuth (GitHub Secrets) ────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── Resend (GitHub Secrets) ─────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── MiniMax (GitHub Secrets) ────────────────────────────
MINIMAX_API_KEY=your_minimax_api_key

# ─── SePay (GitHub Secrets) ──────────────────────────────
SEPAY_WEBHOOK_KEY=your_sepay_webhook_api_key
SEPAY_BANK_SHORT_NAME=MBBank
SEPAY_ACCOUNT_NUMBER=your_account_number
SEPAY_ACCOUNT_NAME=YOUR_NAME

# ─── Docker Image (auto-generated by CD) ─────────────────
GITHUB_REPOSITORY=your-username/mini-booking-system
IMAGE_TAG=latest

# ─── Resource Limits (GitHub Variables) ───────────────────
# Điều chỉnh theo spec VPS tại:
# Repo → Settings → Environments → production → Variables
CPU_LIMIT_API=1.0
MEM_LIMIT_API=512m
CPU_LIMIT_WEB=0.5
MEM_LIMIT_WEB=256m
CPU_LIMIT_POSTGRES=1.0
MEM_LIMIT_POSTGRES=1g
CPU_LIMIT_REDIS=0.5
MEM_LIMIT_REDIS=512m
