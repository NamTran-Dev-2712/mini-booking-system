# ============================================================
# Mini Booking System - Local CI/CD Secrets (nektos/act)
# ============================================================
# Copy file nay thanh .secrets va dien gia tri thuc te:
#   cp .secrets.example .secrets
#
# NEVER commit .secrets to git!
# ============================================================

# ─── Self-hosted Registry ────────────────────────────────────
# Registry tren VPS de thay the GHCR khi GitHub bi suspended
REGISTRY_HOST=registry.yourdomain.com:5000
REGISTRY_USER=deploy
REGISTRY_PASSWORD=your_registry_password
IMAGE_PREFIX=mini-booking

# ─── VPS SSH Access ──────────────────────────────────────────
VPS_HOST=your-vps-ip
VPS_USER=deploy
# Noi dung private key (multiline). act se doc nhu GitHub Secret.
# Cach lay: cat ~/.ssh/id_ed25519
VPS_SSH_KEY=-----BEGIN OPENSSH PRIVATE KEY-----
paste_your_private_key_content_here
-----END OPENSSH PRIVATE KEY-----

# ─── Domain & URLs ───────────────────────────────────────────
PRODUCTION_API_URL=https://api.yourdomain.com
FRONTEND_DOMAIN=yourdomain.com
API_DOMAIN=api.yourdomain.com
SSL_EMAIL=admin@yourdomain.com
FRONTEND_URL=https://yourdomain.com

# ─── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=booking_user
POSTGRES_PASSWORD=your_strong_password
POSTGRES_DB=mini_booking_system

# ─── Redis ───────────────────────────────────────────────────
REDIS_PASSWORD=your_redis_password

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=minimum_32_characters_random_string_here
JWT_ISSUER=MiniBookingSystem
JWT_AUDIENCE=MiniBookingSystemUsers

# ─── Google OAuth ────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── Resend (Email) ──────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=Mini Booking System

# ─── MiniMax (AI) ────────────────────────────────────────────
MINIMAX_API_KEY=your_minimax_api_key

# ─── SePay (Payment) ─────────────────────────────────────────
SEPAY_WEBHOOK_KEY=your_sepay_webhook_api_key
SEPAY_BANK_SHORT_NAME=MBBank
SEPAY_ACCOUNT_NUMBER=your_account_number
SEPAY_ACCOUNT_NAME=YOUR_NAME

# ─── Admin ───────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
