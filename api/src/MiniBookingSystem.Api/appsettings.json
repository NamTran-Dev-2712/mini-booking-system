{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "TrustedProxies": []
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=mini_booking_system;Username=postgres;Password=postgres"
  },
  "BaseUrl": {
    "Api": "http://localhost:5296",
    "Frontend": "http://localhost:5173"
  },
  "SePay": {
    "BankShortName": "MBBank",
    "AccountNumber": "123456789",
    "AccountName": "TRAN VAN A",
    "WebhookApiKey": "your_webhook_api_key",
    "QrBaseUrl": "https://qr.sepay.vn/img",
    "PaymentCodePrefix": "BK"
  },
  "MiniMax": {
    "ApiKey": "",
    "BaseUrl": "https://api.minimax.io/v1/",
    "Model": "MiniMax-M2.7",
    "MaxTokens": 1000
  },
  "JwtSettings": {
    "Secret": "your-very-strong-secret-key",
    "Issuer": "MiniBookingSystem",
    "Audience": "MiniBookingSystemUsers",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "Redis": {
    "ConnectionString": "localhost:6379,password=your_password,abortConnect=false",
    "InstanceName": "booking:dev:",
    "DefaultTtlMinutes": 10
  },
  "Resend": {
    "ApiKey": "your_resend_api_key",
    "FromEmail": "onboarding@resend.dev",
    "FromName": "Mini Booking System"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Formatting.Compact" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "MiniBookingSystemApi"
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.json",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true
        }
      }
    ]
  }
}